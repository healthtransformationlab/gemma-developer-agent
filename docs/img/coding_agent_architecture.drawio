lColor=#B45F06;strokeColor=#B45F06;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="415" y="420" width="750" height="44" as="geometry"/></mxCell><mxCell id="c11" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2FA58D;strokeColor=#12303D;strokeWidth=2;fontColor=#12303D;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="401" y="408" width="32" height="32" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;Traces&lt;/b&gt;&lt;br&gt;every step recorded&lt;br&gt;in MLflow; moving into&lt;br&gt;Unity Catalog tables" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#3D2600;strokeColor=#B45F06;strokeWidth=3;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="428" y="476" width="174" height="104" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;Scoring&lt;/b&gt;&lt;br&gt;the competition's own&lt;br&gt;program runs the&lt;br&gt;hidden tests" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#3D2600;strokeColor=#B45F06;strokeWidth=3;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="612" y="476" width="174" height="104" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;LLM screen&lt;/b&gt;&lt;br&gt;a second model reads each&lt;br&gt;task: is it clearly described?&lt;br&gt;a person checked a sample" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#3D2600;strokeColor=#B45F06;strokeWidth=3;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="796" y="476" width="174" height="104" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;Planned experiment&lt;/b&gt;&lt;br&gt;written down before it ran;&lt;br&gt;results reported even&lt;br&gt;when they showed no gain" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#3D2600;strokeColor=#B45F06;strokeWidth=3;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="980" y="476" width="174" height="104" as="geometry"/></mxCell><mxCell id="c12" value="same agent, same budget, on all three projects" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#12303D;" vertex="1" parent="1"><mxGeometry x="428" y="588" width="724" height="20" as="geometry"/></mxCell><mxCell id="c13" value="Where it runs" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#12303D;" vertex="1" parent="1"><mxGeometry x="415" y="634" width="200" height="22" as="geometry"/></mxCell><mxCell id="w0" value="&lt;b&gt;Hugging Face&lt;/b&gt;&lt;br&gt;the open model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#B45F06;strokeWidth=2;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="415" y="660" width="143" height="56" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;Kaggle&lt;/b&gt;&lt;br&gt;GPUs and the scorer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#147EBA;strokeWidth=2;fillColor=#E6F2F8;" vertex="1" parent="1"><mxGeometry x="566" y="660" width="143" height="56" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;Colab&lt;/b&gt;&lt;br&gt;GPU runs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#ED7100;strokeWidth=2;fillColor=#FDF1E7;" vertex="1" parent="1"><mxGeometry x="717" y="660" width="143" height="56" as="geometry"/></mxCell><mxCell id="w3" value="&lt;b&gt;Databricks&lt;/b&gt;&lt;br&gt;traces, dashboards" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#FF5F46;strokeWidth=2;fillColor=#FFF3F0;" vertex="1" parent="1"><mxGeometry x="868" y="660" width="143" height="56" as="geometry"/></mxCell><mxCell id="w4" value="&lt;b&gt;Snowflake + dbt&lt;/b&gt;&lt;br&gt;&lt;i&gt;design phase&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#8A8F98;strokeColor=#B0B4BA;strokeWidth=2;dashed=1;fillColor=#F2F2F2;" vertex="1" parent="1"><mxGeometry x="1019" y="660" width="146" height="56" as="geometry"/></mxCell><mxCell id="c14" value="A personal learning project · synthetic records only · every number traced to its source" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#DD344C;strokeWidth=2;fillColor=#FBE9EB;" vertex="1" parent="1"><mxGeometry x="415" y="730" width="750" height="34" as="geometry"/></mxCell><mxCell id="res" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#FF5F46;strokeWidth=3;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1220" y="20" width="350" height="760" as="geometry"/></mxCell><mxCell id="c15" value="What it showed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5F46;strokeColor=#FF5F46;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1220" y="20" width="350" height="54" as="geometry"/></mxCell><mxCell id="c16" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2FA58D;strokeColor=#12303D;strokeWidth=2;fontColor=#12303D;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1206" y="8" width="32" height="32" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Working alone&lt;/b&gt;&lt;br&gt;fixed 5 of 48 tasks (10.4%, 95% CI 4.5–22.2)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#1B3A4B;strokeWidth=2;fillColor=#EAF1F4;" vertex="1" parent="1"><mxGeometry x="1238" y="96" width="314" height="64" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Clearly described tasks&lt;/b&gt;&lt;br&gt;8 of 17 fixed at least once, over five runs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#2FA58D;strokeWidth=2;fillColor=#E6F6F2;" vertex="1" parent="1"><mxGeometry x="1238" y="176" width="314" height="64" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;All the other tasks&lt;/b&gt;&lt;br&gt;1 of 76 fixed at least once, over five runs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#DD344C;strokeWidth=2;fillColor=#FBE9EB;" vertex="1" parent="1"><mxGeometry x="1238" y="256" width="314" height="64" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Extra help&lt;/b&gt; (planned experiment, one A100)&lt;br&gt;4, 6 and 4 of 93: no difference detected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#1B3A4B;strokeWidth=2;fillColor=#EAF1F4;" vertex="1" parent="1"><mxGeometry x="1238" y="336" width="314" height="64" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Kaggle development set&lt;/b&gt;&lt;br&gt;3 of the 23 tasks a notebook can verify&lt;br&gt;(95% CI 4.5–32.1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#1B3A4B;strokeWidth=2;fillColor=#EAF1F4;" vertex="1" parent="1"><mxGeometry x="1238" y="416" width="314" height="64" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;Cost&lt;/b&gt;&lt;br&gt;all 93 tasks in about 2 GPU-hours on one A100,&lt;br&gt;an estimated $3.50 to $3.76" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#1B3A4B;strokeWidth=2;fillColor=#EAF1F4;" vertex="1" parent="1"><mxGeometry x="1238" y="496" width="314" height="70" as="geometry"/></mxCell><mxCell id="r7" value="&lt;b&gt;Lesson for data operations&lt;/b&gt;&lt;br&gt;A small agent fixes what is clearly&lt;br&gt;described. Describe the failure well first,&lt;br&gt;then let the agent act." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#3D2600;strokeColor=#B45F06;strokeWidth=3;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="1238" y="590" width="314" height="110" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="plat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" sty